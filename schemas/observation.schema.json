{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neurograph.local/schemas/observation.schema.json",
  "title": "Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "element_id", "kind", "value", "extractor", "extractor_version", "created_at"],
  "properties": {
    "observation_id": {"type": "string"},
    "element_id": {"type": "string"},
    "aligned_element_ids": {"type": "array", "items": {"type": "string"}},
    "kind": {"enum": ["native_text", "ocr", "asr", "vision", "manual", "contextual_prefix"]},
    "value": {"type": "string"},
    "extractor": {"type": "string"},
    "extractor_version": {"type": "string"},
    "prompt_version": {"type": ["string", "null"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "metadata": {"type": "object"}
  }
}
