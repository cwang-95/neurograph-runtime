#!/usr/bin/env python3
"""Batch-generate Graph 3.0 observation embeddings and optionally rebuild ANN."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(HERE))

from neurograph3.embedding import OpenAICompatibleEmbedder
from neurograph3.retrieval import Graph3Retriever
from neurograph3.store import Graph3Store
from neurograph3.vector_index import ANNIndex, ANNUnavailable


def main() -> int:
    parser = argparse.ArgumentParser(description="Batch-index Graph 3.0 observation embeddings")
    parser.add_argument("--storage-root", type=Path, default=HERE / "data" / "graph3")
    parser.add_argument("--embedding-endpoint", required=True)
    parser.add_argument("--embedding-model", default="mlx-community/Qwen3-Embedding-0.6B-4bit-DWQ")
    parser.add_argument("--batch-size", type=int, default=16)
    parser.add_argument("--timeout", type=float, default=30.0)
    parser.add_argument("--force", action="store_true", help="re-embed all observations")
    parser.add_argument("--ann-index", type=Path, help="also rebuild an optional ANN index")
    parser.add_argument("--ann-backend", choices=("auto", "hnswlib", "faiss"), default="auto")
    parser.add_argument("--report", type=Path)
    args = parser.parse_args()
    if args.batch_size < 1:
        parser.error("--batch-size must be positive")

    try:
        embedder = OpenAICompatibleEmbedder(
            endpoint=args.embedding_endpoint,
            model=args.embedding_model,
            timeout=args.timeout,
            batch_size=args.batch_size,
        )
        vector_index = (
            ANNIndex(
                args.ann_index or args.storage_root / "vector_index",
                backend=args.ann_backend,
            )
            if args.ann_index
            else None
        )
        with Graph3Store(args.storage_root) as store:
            total = len(store.list_observations())
            before = len(store.list_embedding_records(model=args.embedding_model))
            indexed = Graph3Retriever(
                store,
                embedder=embedder,
                vector_index=vector_index,
            ).index_vectors(only_missing=not args.force, force=args.force)
            after = len(store.list_embedding_records(model=args.embedding_model))
        report = {
            "storage_root": str(args.storage_root),
            "embedding_endpoint": args.embedding_endpoint,
            "embedding_model": args.embedding_model,
            "total_observations": total,
            "existing_embeddings_before": before,
            "indexed": indexed,
            "skipped": max(total - indexed, 0),
            "embeddings_after": after,
            "force": args.force,
            "ann_index": str(args.ann_index) if args.ann_index else None,
            "ann_backend": vector_index.backend_name if vector_index else None,
        }
    except (ANNUnavailable, ValueError, RuntimeError) as exc:
        print(json.dumps({"error": str(exc)}, ensure_ascii=False))
        return 2

    encoded = json.dumps(report, ensure_ascii=False, indent=2)
    print(encoded)
    if args.report:
        args.report.parent.mkdir(parents=True, exist_ok=True)
        args.report.write_text(encoded + "\n", encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
