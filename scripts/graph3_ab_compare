#!/usr/bin/env python3
"""Compare normalized Graph 3.0 and Cognee baseline evaluation reports."""

from __future__ import annotations

import argparse
import json
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description="Compare Graph 3.0 and Cognee evaluation reports")
    parser.add_argument("--graph3-report", type=Path, required=True)
    parser.add_argument("--baseline-report", type=Path, required=True)
    parser.add_argument("--corpus-match", action="store_true", help="assert both reports use the same corpus")
    args = parser.parse_args()
    graph3 = json.loads(args.graph3_report.read_text(encoding="utf-8"))
    baseline = json.loads(args.baseline_report.read_text(encoding="utf-8"))
    graph3_corpus = graph3.get("corpus_label")
    baseline_corpus = baseline.get("corpus_label")
    comparable = bool(
        graph3_corpus
        and baseline_corpus
        and graph3_corpus != "unspecified"
        and baseline_corpus != "unspecified"
        and graph3_corpus == baseline_corpus
    )
    if args.corpus_match and not comparable:
        print(json.dumps({"error": "corpus labels do not match"}, ensure_ascii=False))
        return 2
    report = {
        "comparable": comparable,
        "corpus_match_asserted": args.corpus_match,
        "corpus_labels": {"graph3": graph3_corpus, "baseline": baseline_corpus},
        "graph3": {
            "pass_rate": graph3.get("pass_rate"),
            "mean_latency_ms": graph3.get("mean_latency_ms"),
            "p95_latency_ms": graph3.get("p95_latency_ms"),
        },
        "baseline": {
            "pass_rate": baseline.get("pass_rate"),
            "mean_latency_ms": baseline.get("mean_latency_ms"),
            "p95_latency_ms": baseline.get("p95_latency_ms"),
        },
        "delta_graph3_minus_baseline": (
            {
                "pass_rate": graph3.get("pass_rate", 0.0) - baseline.get("pass_rate", 0.0),
                "mean_latency_ms": graph3.get("mean_latency_ms", 0.0) - baseline.get("mean_latency_ms", 0.0),
                "p95_latency_ms": graph3.get("p95_latency_ms", 0.0) - baseline.get("p95_latency_ms", 0.0),
            }
            if comparable
            else None
        ),
        "unsupported_by_baseline": baseline.get("unsupported_metrics", []),
    }
    print(json.dumps(report, ensure_ascii=False, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
