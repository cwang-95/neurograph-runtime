#!/bin/bash
# ============================================================
# kb_search — 知识图谱自动检索工具(自动感知的"第一查")
# 用法: kb_search "查询内容" [topN] [--answer|--answer-draft|--graph-evidence|--evidence] [--json]
#   查询内容:  必填
#   topN:      可选, 返回几条(默认4)
#   --memory:  查记忆域(memory_rag, 私有经历)
#   --github:  只查 GitHub 项目数据集
#   --all:     查文献+项目
# 默认: --graph-evidence（图增强证据，由 OpenClaw/Codex 上层模型回答）
# 输出: 精简 Top 结果, 便于 agent 直接读取并基于图谱作答
# 后端: 默认 cognee；设置 NEUROGRAPH_BACKEND=graph3 时走 Graph 3.0（仅知识域）
# ============================================================
cd ~/.openclaw/workspace/projects/neurograph/cognee-bridge
export SSL_CERT_FILE=/etc/ssl/cert.pem CURL_CA_BUNDLE=/etc/ssl/cert.pem
# TUN 模式已全局接管（2026-08-14 起），无需显式 1097 代理
export NO_PROXY="us.i.posthog.com,api.posthog.com,127.0.0.1,localhost"

Q="$1"
TOP="4"
DOMAIN="knowledge"
DATASETS="wiki_full"
MODE="graph-evidence"
FORMAT="text"

for a in "${@:2}"; do
  case "$a" in
    '' ) ;;
    *[!0-9]* ) ;;
    * ) TOP="$a"; continue ;;
  esac
  case "$a" in
    --memory) DOMAIN="memory" ;;
    --github) DATASETS="github_projects" ;;
    --all)    DATASETS="wiki_full,github_projects" ;;
    --evidence|--chunks) MODE="evidence" ;;
    --graph-evidence) MODE="graph-evidence" ;;
    --answer-draft) MODE="answer-draft" ;;
    --answer) MODE="answer" ;;
    --json) FORMAT="json" ;;
    *) echo "未知参数: $a" >&2; exit 2 ;;
  esac
done

DSKEY=$(python3 -c "import json,os; print(json.load(open(os.path.expanduser('~/.openclaw/openclaw.json')))['env']['DASHSCOPE_API_KEY'])" 2>/dev/null)
export DASHSCOPE_API_KEY="$DSKEY"

if [[ -z "$Q" ]]; then
  echo "用法: kb_search \"查询内容\" [topN] [--answer|--answer-draft|--graph-evidence|--evidence] [--json]"
  exit 1
fi

# Graph 3.0 is an explicit, reversible opt-in. The stable default remains Cognee.
if [[ "${NEUROGRAPH_BACKEND:-cognee}" == "graph3" && "$DOMAIN" != "memory" ]]; then
  GRAPH3_ROOT="${NEUROGRAPH_GRAPH3_ROOT:-/Users/wangcheng/Projects/neurograph-graph-3.0}"
  GRAPH3_STORAGE="${NEUROGRAPH_GRAPH3_STORAGE:-$GRAPH3_ROOT/data/graph3}"
  GRAPH3_PYTHON="${NEUROGRAPH_GRAPH3_PYTHON:-$GRAPH3_ROOT/.venv/bin/python}"
  if [[ ! -x "$GRAPH3_PYTHON" ]]; then
    GRAPH3_PYTHON="$HOME/.cognee-venv/bin/python"
  fi
  GRAPH3_QUERY="$GRAPH3_ROOT/scripts/graph3_query"
  GRAPH3_ANSWER="$GRAPH3_ROOT/scripts/graph3_answer"
  if [[ "$MODE" == "answer-draft" ]]; then
    GRAPH3_ENTRY="$GRAPH3_ANSWER"
  else
    GRAPH3_ENTRY="$GRAPH3_QUERY"
  fi
  if [[ ! -x "$GRAPH3_ENTRY" ]]; then
    echo "Graph 3.0 查询入口不存在或不可执行: $GRAPH3_ENTRY" >&2
    exit 2
  fi
  GRAPH3_ARGS=("$Q" --storage-root "$GRAPH3_STORAGE" --top "$TOP")
  if [[ "${NEUROGRAPH_GRAPH3_FSRS:-0}" == "1" ]]; then
    GRAPH3_ARGS+=(--fsrs)
  fi
  if [[ -n "${NEUROGRAPH_GRAPH3_EMBEDDING_ENDPOINT:-}" ]]; then
    GRAPH3_ARGS+=(--embedding-endpoint "$NEUROGRAPH_GRAPH3_EMBEDDING_ENDPOINT")
  fi
  if [[ -n "${NEUROGRAPH_GRAPH3_EMBEDDING_MODEL:-}" ]]; then
    GRAPH3_ARGS+=(--embedding-model "$NEUROGRAPH_GRAPH3_EMBEDDING_MODEL")
  fi
  if [[ -n "${NEUROGRAPH_GRAPH3_EMBEDDING_TIMEOUT:-}" ]]; then
    GRAPH3_ARGS+=(--embedding-timeout "$NEUROGRAPH_GRAPH3_EMBEDDING_TIMEOUT")
  fi
  if [[ -n "${NEUROGRAPH_GRAPH3_ANN_INDEX:-}" ]]; then
    GRAPH3_ARGS+=(--ann-index "$NEUROGRAPH_GRAPH3_ANN_INDEX")
  fi
  if [[ -n "${NEUROGRAPH_GRAPH3_ANN_BACKEND:-}" ]]; then
    GRAPH3_ARGS+=(--ann-backend "$NEUROGRAPH_GRAPH3_ANN_BACKEND")
  fi
  if [[ "$MODE" == "answer" ]]; then
    echo "Graph 3.0 后端当前只返回 EvidencePack；请使用 --graph-evidence，由上层模型回答。" >&2
    exit 2
  fi
  if [[ "$MODE" == "answer-draft" ]]; then
    GRAPH3_ARGS+=(--max-items "$TOP")
  fi
  exec "$GRAPH3_PYTHON" -u "$GRAPH3_ENTRY" "${GRAPH3_ARGS[@]}"
fi

if [[ "$DOMAIN" == "memory" ]]; then
  ~/.cognee-venv/bin/python -u query.py "$Q" --top "$TOP" --domain memory 2>/dev/null
else
  ~/.cognee-venv/bin/python -u query.py "$Q" --top "$TOP" --datasets "$DATASETS" \
    --mode "$MODE" --format "$FORMAT" 2>/dev/null
fi
