#!/bin/bash
# ============================================================
# kb_search — 知识图谱自动检索工具(自动感知的"第一查")
# 用法: kb_search "查询内容" [topN] [--answer|--answer-draft|--graph-evidence|--evidence] [--json]
#   查询内容:  必填
#   topN:      可选, 返回几条(默认4)
#   --memory:  查记忆域(memory_rag, 私有经历)
#   --github:  只查 GitHub 项目数据集
#   --all:     查文献+项目
# 默认知识域后端: Graph 3.0；回滚: NEUROGRAPH_BACKEND=cognee
# 默认模式: --graph-evidence（图增强证据，由 OpenClaw/Codex 上层模型回答）
# 输出: 精简 Top 结果, 便于 agent 直接读取并基于图谱作答
# 知识域后端: 默认 Graph 3.0；回滚: NEUROGRAPH_BACKEND=cognee
# ============================================================
SCRIPT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$SCRIPT_ROOT/cognee-bridge"
export SSL_CERT_FILE=/etc/ssl/cert.pem CURL_CA_BUNDLE=/etc/ssl/cert.pem
# TUN 模式已全局接管（2026-08-14 起），无需显式 1097 代理
export NO_PROXY="us.i.posthog.com,api.posthog.com,127.0.0.1,localhost"

Q="$1"
TOP="4"
DOMAIN="knowledge"
DATASETS="wiki_full"
MODE="graph-evidence"
FORMAT="text"

for a in "${@:2}"; do
  case "$a" in
    '' ) ;;
    *[!0-9]* ) ;;
    * ) TOP="$a"; continue ;;
  esac
  case "$a" in
    --memory) DOMAIN="memory" ;;
    --github) DATASETS="github_projects" ;;
    --all)    DATASETS="wiki_full,github_projects" ;;
    --evidence|--chunks) MODE="evidence" ;;
    --graph-evidence) MODE="graph-evidence" ;;
    --answer-draft) MODE="answer-draft" ;;
    --answer) MODE="answer" ;;
    --json) FORMAT="json" ;;
    *) echo "未知参数: $a" >&2; exit 2 ;;
  esac
done

CONFIG_PYTHON="${PYTHON_BIN:-}"
if [[ -z "$CONFIG_PYTHON" ]]; then
  CONFIG_PYTHON="$(command -v python3 || command -v python || true)"
fi
DSKEY=""
if [[ -n "$CONFIG_PYTHON" ]]; then
  DSKEY=$("$CONFIG_PYTHON" -c "import json,os; print(json.load(open(os.path.expanduser('~/.openclaw/openclaw.json')))['env']['DASHSCOPE_API_KEY'])" 2>/dev/null)
fi
export DASHSCOPE_API_KEY="$DSKEY"

if [[ -z "$Q" ]]; then
  echo "用法: kb_search \"查询内容\" [topN] [--answer|--answer-draft|--graph-evidence|--evidence] [--json]"
  exit 1
fi

# Graph 3.0 is the deployed knowledge-domain backend. The old Cognee path
# remains the explicit rollback and continues to serve memory/project domains.
if [[ "${NEUROGRAPH_BACKEND:-graph3}" == "graph3" && "$DOMAIN" == "knowledge" && "$DATASETS" == "wiki_full" ]]; then
  GRAPH3_ROOT="${NEUROGRAPH_GRAPH3_ROOT:-$SCRIPT_ROOT}"
  GRAPH3_STORAGE="${NEUROGRAPH_GRAPH3_STORAGE:-$GRAPH3_ROOT/data/graph3-openclaw-full}"
  GRAPH3_PYTHON="${NEUROGRAPH_GRAPH3_PYTHON:-}"
  if [[ -z "$GRAPH3_PYTHON" ]]; then
    for candidate in \
      "$GRAPH3_ROOT/.venv/bin/python" \
      "$GRAPH3_ROOT/.venv/Scripts/python.exe" \
      "$HOME/.cognee-venv/bin/python" \
      "$HOME/.cognee-venv/Scripts/python.exe"; do
      if [[ -x "$candidate" ]]; then
        GRAPH3_PYTHON="$candidate"
        break
      fi
    done
  fi
  if [[ -z "$GRAPH3_PYTHON" || ! -x "$GRAPH3_PYTHON" ]]; then
    echo "Graph 3.0 Python 解释器不存在，请设置 NEUROGRAPH_GRAPH3_PYTHON" >&2
    exit 2
  fi
  GRAPH3_QUERY="$GRAPH3_ROOT/scripts/graph3_query"
  GRAPH3_ANSWER="$GRAPH3_ROOT/scripts/graph3_answer"
  if [[ "$MODE" == "answer-draft" ]]; then
    GRAPH3_ENTRY="$GRAPH3_ANSWER"
  else
    GRAPH3_ENTRY="$GRAPH3_QUERY"
  fi
  if [[ ! -x "$GRAPH3_ENTRY" ]]; then
    echo "Graph 3.0 查询入口不存在或不可执行: $GRAPH3_ENTRY" >&2
    exit 2
  fi
  GRAPH3_ARGS=("$Q" --storage-root "$GRAPH3_STORAGE" --top "$TOP")
  # 默认开启 FSRS(ZenBrain 反馈增强),让检索开始积累记忆先验;可被环境变量覆盖
  if [[ "${NEUROGRAPH_GRAPH3_FSRS:-1}" == "1" ]]; then
    GRAPH3_ARGS+=(--fsrs)
  fi
  # 默认走常驻 embedding 服务(8003,本地 rapid-mlx);可被环境变量覆盖
  if [[ "${NEUROGRAPH_GRAPH3_DISABLE_EMBEDDING:-0}" == "1" ]]; then
    EMBED_EP=""
  else
    EMBED_EP="${NEUROGRAPH_GRAPH3_EMBEDDING_ENDPOINT:-http://127.0.0.1:8003/v1/embeddings}"
  fi
  EMBED_MODEL="${NEUROGRAPH_GRAPH3_EMBEDDING_MODEL:-mlx-community/Qwen3-Embedding-0.6B-4bit-DWQ}"
  if [[ -n "$EMBED_EP" ]]; then
    GRAPH3_ARGS+=(--embedding-endpoint "$EMBED_EP")
  fi
  if [[ -n "$EMBED_MODEL" ]]; then
    GRAPH3_ARGS+=(--embedding-model "$EMBED_MODEL")
  fi
  if [[ -n "${NEUROGRAPH_GRAPH3_EMBEDDING_TIMEOUT:-}" ]]; then
    GRAPH3_ARGS+=(--embedding-timeout "$NEUROGRAPH_GRAPH3_EMBEDDING_TIMEOUT")
  fi
  if [[ -n "${NEUROGRAPH_GRAPH3_ANN_INDEX:-}" ]]; then
    GRAPH3_ARGS+=(--ann-index "$NEUROGRAPH_GRAPH3_ANN_INDEX")
  elif [[ -d "$GRAPH3_STORAGE/vector_index" ]]; then
    GRAPH3_ARGS+=(--ann-index "$GRAPH3_STORAGE/vector_index")
  fi
  if [[ -n "${NEUROGRAPH_GRAPH3_ANN_BACKEND:-}" ]]; then
    GRAPH3_ARGS+=(--ann-backend "$NEUROGRAPH_GRAPH3_ANN_BACKEND")
  fi
  if [[ "$MODE" == "answer" ]]; then
    echo "Graph 3.0 后端当前只返回 EvidencePack；请使用 --graph-evidence，由上层模型回答。" >&2
    exit 2
  fi
  if [[ "$MODE" == "answer-draft" ]]; then
    GRAPH3_ARGS+=(--max-items "$TOP")
  fi
  exec "$GRAPH3_PYTHON" -u "$GRAPH3_ENTRY" "${GRAPH3_ARGS[@]}"
fi

if [[ "$DOMAIN" == "memory" ]]; then
  ~/.cognee-venv/bin/python -u query.py "$Q" --top "$TOP" --domain memory 2>/dev/null
else
  ~/.cognee-venv/bin/python -u query.py "$Q" --top "$TOP" --datasets "$DATASETS" \
    --mode "$MODE" --format "$FORMAT" 2>/dev/null
fi
